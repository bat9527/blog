---
const { activeTab = 'home', theme = 'light' } = Astro.props;
const isDark = theme === 'dark';
---

<aside class={`hidden md:flex flex-col w-[280px] h-screen fixed top-0 left-0 z-10 transition-colors ${isDark ? 'bg-[#090b0e] border-r border-gray-900 text-gray-100' : 'bg-white border-r border-gray-100 text-gray-900'}`}>
  <div class="p-6 pb-2">
    <div class="flex items-center gap-3 mb-8">
      <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/avatar.jpg`} class="w-10 h-10 rounded-full border border-gray-100/10" alt="User" />
      <div class="flex-1 min-w-0">
        <div class={`text-base font-bold truncate ${isDark ? 'text-gray-100' : 'text-gray-900'}`}>Andy</div>
        <div class={`text-xs truncate ${isDark ? 'text-gray-400' : 'text-gray-500'}`}>@andywli</div>
      </div>
    </div>

    <nav class="space-y-1">
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`}
        class={`flex items-center gap-3 px-3 py-2 rounded-md transition-colors ${
          activeTab === 'home' 
            ? (isDark ? 'bg-gray-900 text-amber-300' : 'bg-gray-100 text-gray-900') 
            : (isDark ? 'text-gray-400 hover:bg-gray-950 hover:text-gray-200' : 'text-gray-600 hover:bg-gray-50')
        }`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
        </svg>
        <span class="font-medium text-sm">Home</span>
      </a>

      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/english`}
        class={`flex items-center gap-3 px-3 py-2 rounded-md transition-colors ${
          activeTab === 'english' 
            ? (isDark ? 'bg-gray-900 text-amber-300' : 'bg-gray-100 text-gray-900') 
            : (isDark ? 'text-gray-400 hover:bg-gray-950 hover:text-gray-200' : 'text-gray-600 hover:bg-gray-50')
        }`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9A18.022 18.022 0 016.412 9m6.088 9h7m-7 0a15.968 15.968 0 01-1.373-6m1.373 6l-2.755 3m2.755-3l2.755 3m6-13l-4 10-1.5-4.5L11 10l10-4z"></path>
        </svg>
        <span class="font-medium text-sm">English</span>
      </a>

      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/metaphysics`}
        class={`flex items-center gap-3 px-3 py-2 rounded-md transition-colors ${
          activeTab === 'metaphysics' 
            ? (isDark ? 'bg-gray-900 text-amber-300' : 'bg-gray-100 text-gray-900') 
            : (isDark ? 'text-gray-400 hover:bg-gray-950 hover:text-gray-200' : 'text-gray-600 hover:bg-gray-50')
        }`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 2a10 10 0 100 20 10 10 0 000-20zm0 4v12m-6-6h12m-3-3l6 6m-6 0l6-6m-12 12l6-6m-6 0l6 6"></path>
        </svg>
        <span class="font-medium text-sm">Metaphysics</span>
      </a>

      <a
        href="#"
        class={`flex items-center gap-3 px-3 py-2 rounded-md transition-colors ${isDark ? 'text-gray-400 hover:bg-gray-950 hover:text-gray-200' : 'text-gray-600 hover:bg-gray-50'}`}
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
        </svg>
        <span class="font-medium text-sm">Notifications</span>
      </a>
    </nav>
  </div>
</aside>
