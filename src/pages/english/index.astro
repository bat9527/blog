---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import RightPanel from '../../components/RightPanel.astro';
import EnglishSectionNav from '../../components/EnglishSectionNav.astro';
import { getCollection } from 'astro:content';
import {
  getEnglishSectionCounts,
  isEnglishPost,
  sortPostsByDate,
} from '../../data/english';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const allPosts = await getCollection('blog');
const englishPosts = sortPostsByDate(allPosts.filter(isEnglishPost));
const counts = getEnglishSectionCounts(englishPosts);
---

<Layout title="Andy Blog - English" ogImage={`${basePath}/images/avatar.jpg`}>
  <div class="flex min-h-screen bg-white overflow-x-hidden md:h-screen md:overflow-hidden">
    <Sidebar activeTab="english" />

    <main class="flex-1 border-r border-gray-100 min-h-screen relative overflow-x-hidden md:h-full md:overflow-y-auto md:ml-[280px]">
      <div class="w-[90%] md:max-w-[720px] mx-auto pt-6 md:pt-10 min-h-screen pb-20">
        <EnglishSectionNav activeSection="all" counts={counts} totalCount={englishPosts.length} />

        <div class="mt-2 px-4 md:px-0">
          {englishPosts.length > 0 ? (
            englishPosts.map((post) => (
              <ArticleCard
                id={post.slug}
                title={post.data.title}
                subtitle={post.data.subtitle}
                publishedAt={post.data.publishedAt}
                readTime={post.data.readTime}
                tags={post.data.tags}
                thumbnailUrl={post.data.thumbnailUrl}
              />
            ))
          ) : (
            <div class="py-20 text-center text-gray-500">
              <p>No English content yet.</p>
            </div>
          )}

          {englishPosts.length > 0 && (
            <div class="py-10 text-center text-gray-500 text-sm">
              Keep collecting good English material.
            </div>
          )}
        </div>
      </div>
    </main>

    <RightPanel />
  </div>
</Layout>
